rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vagas'])
                    && request.resource.data.vagas >= 0;
    }

    match /registrations/{regId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && regId == request.auth.uid + '_' + request.resource.data.eventId;
      allow read: if request.auth != null
                  && (regId.matches(request.auth.uid + '_.*')
                      || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null
                    && regId.matches(request.auth.uid + '_.*');
    }

    match /favorites/{favId} {
      allow get: if request.auth != null && favId.matches(request.auth.uid + '_.*');
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                && request.resource.data.userId == request.auth.uid
                && favId == request.auth.uid + '_' + request.resource.data.eventId;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                && request.resource.data.autorId == request.auth.uid;
      allow update, delete: if request.auth != null
                && resource.data.autorId == request.auth.uid;
   }

   match /ratings/{ratingId} {
  allow read: if request.auth != null;
  allow create, update: if request.auth != null
    && request.resource.data.userId == request.auth.uid
    && ratingId == request.auth.uid + '_' + request.resource.data.eventId
    && request.resource.data.nota is int
    && request.resource.data.nota >= 1
    && request.resource.data.nota <= 5
    && exists(/databases/$(database)/documents/registrations/$(ratingId))
    && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.dataHora < request.time;
  allow delete: if false;
}
  }
}